# InGrow Environment Configuration Template
# NOTE: Never commit sensitive keys or secrets. Production secrets are managed securely via KMS/Secret Store.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Regulatory & Legal Contact Configuration
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@ingrow.in
NEXT_PUBLIC_SUPPORT_EMAIL=support@ingrow.in
NEXT_PUBLIC_COMPLIANCE_OFFICER_NAME="Compliance Officer"

# Note on Service Integrations:
# All real fund transactions and AutoPay mandates execute via regulated partner gateways.
# In development/prototype mode, mock service adapters are loaded by default.
